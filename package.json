{
  "name": "phaser-games",
  "private": true,
  "workspaces": [
    "games/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test --pass-with-no-tests",
    "lint": "oxlint",
    "format": "oxfmt",
    "typecheck": "tsc -p tsconfig.json && bun run --filter '*' typecheck"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
